{
  "name": "cognity",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "caffeinate -ims mastra dev",
    "build": "mastra build",
    "start": "caffeinate -ims mastra start",
    "dev:all": "lsof -i :11434 > /dev/null && echo 'Ollama already active natively.' || (ollama serve & sleep 2); caffeinate -ims docker compose up -d",
    "dev:local-telegram": "lsof -i :11434 > /dev/null && echo 'Ollama already running!' || (ollama serve & sleep 3) && npm run dev:telegram",
    "dev:telegram": "caffeinate -ims node --env-file=.env --experimental-strip-types src/bots/telegram/bot.ts",
    "start:telegram": "caffeinate -ims node --env-file=.env --experimental-strip-types src/bots/telegram/bot.ts",
    "start:telegram:docker": "node --experimental-strip-types src/bots/telegram/bot.ts"
  },
  "keywords": [],
