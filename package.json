{
  "name": "cognity",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "caffeinate -s mastra dev",
    "build": "mastra build",
    "start": "caffeinate -s mastra start",
    "dev:all": "lsof -i :11434 > /dev/null && echo 'Ollama already active natively.' || (ollama serve & sleep 2); caffeinate -s docker compose up -d",
    "dev:all:build": "lsof -i :11434 >/dev/null && echo 'Ollama already active natively.' || (ollama serve & sleep 2); caffeinate -s docker compose up --build --force-recreate -d",
    "dev:local-telegram": "lsof -i :11434 > /dev/null && echo 'Ollama already running!' || (ollama serve & sleep 3) && npm run dev:telegram",
    "dev:telegram": "caffeinate -s tsx --env-file=.env src/bots/telegram/bot.ts",
    "start:telegram": "caffeinate -s tsx --env-file=.env src/bots/telegram/bot.ts",
    "start:telegram:docker": "tsx src/bots/telegram/bot.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "^1.50.1",
    "@mastra/duckdb": "^1.5.1",
    "@mastra/evals": "^1.5.1",
    "@mastra/libsql": "^1.15.1",
    "@mastra/loggers": "^1.2.0",
    "@mastra/mcp": "^1.14.0",
    "@mastra/memory": "^1.22.2",
    "@mastra/observability": "^1.16.0",
    "@tavily/core": "^0.7.6",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "mastra": "^1.18.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
