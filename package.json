  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "^1.50.1",
    "@mastra/duckdb": "^1.5.1",
    "@mastra/evals": "^1.5.1",
    "@mastra/libsql": "^1.15.1",
    "@mastra/loggers": "^1.2.0",
    "@mastra/mcp": "^1.14.0",
    "@mastra/memory": "^1.22.2",
    "@mastra/observability": "^1.16.0",
    "firecrawl": "^4.30.0",
    "zod": "^4.4.3"
  },
